@model IEnumerable<UniversityCafeteria.Models.DatabaseFirst.Category>

<h2>Categories</h2>

<a asp-controller="Category"
   asp-action="Create"
   class="btn btn-primary">
    Add Category
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
            </tr>
        }
    </tbody>
</table>
