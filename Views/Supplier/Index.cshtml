@model IEnumerable<UniversityCafeteria.Models.DatabaseFirst.Supplier>

<h2>Suppliers</h2>

<a asp-controller="Supplier"
   asp-action="Create"
   class="btn btn-primary">
    Add Supplier
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>
