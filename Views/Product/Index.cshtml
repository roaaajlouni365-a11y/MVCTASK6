@model IEnumerable<UniversityCafeteria.Models.DatabaseFirst.Product>

<h2>Products</h2>

<a asp-controller="Product"
   asp-action="Create"
   class="btn btn-primary">
    Add Product
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Supplier</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@item.Category?.Name</td>
                <td>@item.Supplier?.Name</td>
            </tr>
        }
    </tbody>
</table>
